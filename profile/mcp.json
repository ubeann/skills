{
  "mcpServers": {
    "recraft": {
      "type": "http",
      "url": "https://mcp.recraft.ai/mcp"
    },
    "pencil": {
      "command": "/Applications/Pen.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64",
      "args": [
        "--app",
        "desktop",
        "--agent",
        "claudeCodeCLI"
      ],
      "env": {},
      "type": "stdio"
    },
    "yab-browser": {
      "type": "stdio",
      "command": "/Applications/yab.app/Contents/MacOS/yab",
      "args": [
        "mcp"
      ],
      "env": {}
    }
  }
}
